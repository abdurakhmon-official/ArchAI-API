generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

generator zod {
  provider                  = "zod-prisma-types"
  output                    = "../generated/zod"
  createRelationValuesTypes = "true"
  useMultipleFiles          = "true"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model User {
  id                String              @id @default(cuid())
  fullName          String
  email             String              @unique
  password          String
  role              USER_ROLE           @default(USER)
  phone             String?
  avatar            String?
  locale            String              @default("uz")
  emailVerified     Boolean             @default(false) @map("email_verified")
  /// Parol oxirgi marta o'zgargan payt — undan oldingi tokenlar rad etiladi.
  passwordChangedAt DateTime?           @map("password_changed_at")
  active            Boolean             @default(true)
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")
  projects          Project[]
  subscriptions     Subscription[]
  payments          Payment[]
  posts             BlogPost[]
  auditLogs         AuditLog[]
  media             Media[]
  verifications     VerificationToken[]
  priceProfiles     PriceProfile[]

  @@index([email])
  @@map("users")
}

/// Foydalanuvchining o'z narxlari — loyihalar orasida qayta ishlatiladi.
model PriceProfile {
  id     String @id @default(cuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name      String
  /// `EstimateSelection` — band kodidan tanlovga.
  selection Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("price_profiles")
}

enum VERIFICATION_PURPOSE {
  EMAIL
  PASSWORD_RESET
}

/// Email tasdiqlash va parolni tiklash tokeni.
model VerificationToken {
  id String @id @default(cuid())

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Token XESHI — xom qiymat faqat xatga tushadi va saqlanmaydi.
  tokenHash String               @unique @map("token_hash")
  purpose   VERIFICATION_PURPOSE
  expiresAt DateTime             @map("expires_at")
  /// Bir marta ishlatiladi: to'ldirilgan bo'lsa token o'lik.
  usedAt    DateTime?            @map("used_at")
  createdAt DateTime             @default(now()) @map("created_at")

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("verification_tokens")
}

model Style {
  id            String         @id @default(cuid())
  slug          String         @unique
  name          Json
  description   Json?
  roof          Json
  roofStyleId   String?        @map("roof_style_id")
  roofStyle     RoofStyle?     @relation(fields: [roofStyleId], references: [id], onDelete: SetNull)
  facade        Json
  window        Json
  interior      Json
  layoutRules   Json           @map("layout_rules")
  furnitureSets Json?          @map("furniture_sets")
  previewUrl    String?        @map("preview_url")
  status        CONTENT_STATUS @default(DRAFT)
  sort          Int            @default(0)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  projects      Project[]

  @@index([status])
  @@map("styles")
}

model RoofStyle {
  id          String         @id @default(cuid())
  code        String         @unique
  name        Json
  family      ROOF_FAMILY
  pitch       Float          @default(25)
  overhang    Float          @default(0.5)
  upperPitch  Float?         @map("upper_pitch")
  breakRatio  Float?         @map("break_ratio")
  coveringId  String?        @map("covering_id")
  covering    PriceOption?   @relation(fields: [coveringId], references: [id], onDelete: SetNull)
  color       String?
  previewUrl  String?        @map("preview_url")
  status      CONTENT_STATUS @default(DRAFT)
  sort        Int            @default(0)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  styles      Style[]

  @@index([status])
  @@map("roof_styles")
}

model RoomType {
  id                String   @id @default(cuid())
  code              String   @unique
  name              Json
  minArea           Float    @map("min_area")
  maxArea           Float    @map("max_area")
  idealRatio        Float    @default(1.4) @map("ideal_ratio")
  needsExteriorWall Boolean  @default(true) @map("needs_exterior_wall")
  isWetZone         Boolean  @default(false) @map("is_wet_zone")
  accessFrom        String[] @default([]) @map("access_from")
  furnitureTags     String[] @default([]) @map("furniture_tags")
  /// Quyosh bo'yicha afzal tomonlar. Bo'sh — farqi yo'q.
  sunSides          String[] @default([]) @map("sun_sides")
  selectable        Boolean  @default(false)
  maxCount          Int      @default(8) @map("max_count")
  defaultCount      Int      @default(0) @map("default_count")
  sort              Int      @default(0)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("room_types")
}

model Skeleton {
  id          String         @id @default(cuid())
  name        String
  floors      Int            @default(1)
  tree        Json
  tagBedrooms Int[]          @default([]) @map("tag_bedrooms")
  tagStyles   String[]       @default([]) @map("tag_styles")
  minWidth    Float          @map("min_width")
  maxWidth    Float          @map("max_width")
  minLength   Float          @map("min_length")
  maxLength   Float          @map("max_length")
  status      CONTENT_STATUS @default(DRAFT)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  projects    Project[]

  @@index([floors, status])
  @@map("skeletons")
}

model Media {
  id           String     @id @default(cuid())
  type         MEDIA_TYPE @default(IMAGE)
  url          String
  key          String     @unique
  originalName String     @map("original_name")
  mimeType     String     @map("mime_type")
  size         Int
  uploadedBy   String?    @map("uploaded_by")
  createdAt    DateTime   @default(now()) @map("created_at")
  uploader     User?      @relation(fields: [uploadedBy], references: [id], onDelete: SetNull)

  @@index([type])
  @@index([uploadedBy])
  @@map("media")
}

model FurnitureAsset {
  id         String   @id @default(cuid())
  name       Json
  gltfUrl    String   @map("gltf_url")
  thumbUrl   String?  @map("thumb_url")
  roomTypes  String[] @default([]) @map("room_types")
  styleTags  String[] @default([]) @map("style_tags")
  footprint  Json
  placement  String   @default("WALL")
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("furniture_assets")
}

model PriceItem {
  id        String         @id @default(cuid())
  category  PRICE_CATEGORY
  code      String         @unique
  name      Json
  unit      String
  unitPrice Decimal        @db.Decimal(14, 2) @map("unit_price")
  measure   String
  sort      Int            @default(0)
  active    Boolean        @default(true)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  options   PriceOption[]

  @@index([category])
  @@map("price_items")
}

model PriceOption {
  id          String      @id @default(cuid())
  priceItemId String      @map("price_item_id")
  code        String
  name        Json
  description Json?
  unitPrice   Decimal     @db.Decimal(14, 2) @map("unit_price")
  imageUrl    String?     @map("image_url")
  sort        Int         @default(0)
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  item        PriceItem   @relation(fields: [priceItemId], references: [id], onDelete: Cascade)
  roofStyles  RoofStyle[]

  @@unique([priceItemId, code])
  @@index([priceItemId])
  @@map("price_options")
}

model FinishLevel {
  id        String   @id @default(cuid())
  code      String   @unique
  name      Json
  defaults  Json     @default("{}")
  sort      Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @default(now()) @map("updated_at")

  @@map("finish_levels")
}

model Project {
  id                String           @id @default(cuid())
  userId            String           @map("user_id")
  styleId           String?          @map("style_id")
  skeletonId        String?          @map("skeleton_id")
  title             String
  note              String?
  params            Json
  geometry          Json
  estimate          Json?
  estimateTotal     Decimal?         @db.Decimal(14, 2) @map("estimate_total")
  estimateSelection Json?            @map("estimate_selection")
  finishLevel       String           @default("standard") @map("finish_level")
  coverSvg          String?          @map("cover_svg")
  deletedAt         DateTime?        @map("deleted_at")
  /// Ulashish havolasi tokeni. NULL — ulashilmagan.
  shareToken        String?          @unique @map("share_token")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  style             Style?           @relation(fields: [styleId], references: [id], onDelete: SetNull)
  skeleton          Skeleton?        @relation(fields: [skeletonId], references: [id], onDelete: SetNull)
  versions          ProjectVersion[]
  exports           ProjectExport[]

  @@index([userId, deletedAt])
  @@map("projects")
}

model ProjectExport {
  id            String      @id @default(cuid())
  projectId     String      @map("project_id")
  kind          EXPORT_KIND @default(PDF)
  storageKey    String      @map("storage_key")
  geometryHash  String      @map("geometry_hash")
  watermark     Boolean     @default(false)
  sizeBytes     Int?        @map("size_bytes")
  expiresAt     DateTime?   @map("expires_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  project       Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, kind, geometryHash, watermark])
  @@index([expiresAt])
  @@map("project_exports")
}

model ProjectVersion {
  id            String   @id @default(cuid())
  projectId     String   @map("project_id")
  geometry      Json
  params        Json
  estimateTotal Decimal? @db.Decimal(14, 2) @map("estimate_total")
  label         String?
  createdAt     DateTime @default(now()) @map("created_at")
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@map("project_versions")
}

model Plan {
  id            String         @id @default(cuid())
  code          String         @unique
  name          Json
  description   Json?
  priceUzs      Decimal        @db.Decimal(14, 2) @map("price_uzs")
  priceUsd      Decimal        @db.Decimal(10, 2) @map("price_usd")
  limits        Json
  sort          Int            @default(0)
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id          String              @id @default(cuid())
  userId      String              @map("user_id")
  planId      String              @map("plan_id")
  status      SUBSCRIPTION_STATUS @default(PENDING)
  provider    PAYMENT_PROVIDER?
  periodStart DateTime?           @map("period_start")
  periodEnd   DateTime?           @map("period_end")
  autoRenew   Boolean             @default(true) @map("auto_renew")
  externalId  String?             @map("external_id")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan        Plan                @relation(fields: [planId], references: [id])
  payments    Payment[]

  @@index([userId, status])
  @@map("subscriptions")
}

model Payment {
  id             String           @id @default(cuid())
  userId         String           @map("user_id")
  subscriptionId String?          @map("subscription_id")
  provider       PAYMENT_PROVIDER
  amount         Decimal          @db.Decimal(14, 2)
  currency       String           @default("UZS")
  status         PAYMENT_STATUS   @default(PENDING)
  externalId     String           @map("external_id")
  raw            Json?
  paidAt         DateTime?        @map("paid_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription   Subscription?    @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@unique([provider, externalId])
  @@index([userId])
  @@map("payments")
}

model PayoutCard {
  id        String           @id @default(cuid())
  provider  PAYMENT_PROVIDER
  label     String
  /// Faqat oxirgi 4 raqam saqlanadi — to'liq raqam hech qachon bazada turmaydi.
  last4     String
  holder    String
  expiry    String
  /// Provayderdagi hisob identifikatori (merchant/payout account).
  accountId String           @map("account_id")
  active    Boolean          @default(false)
  createdBy String?          @map("created_by")
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  @@index([provider, active])
  @@map("payout_cards")
}

model BlogCategory {
  id        String     @id @default(cuid())
  slug      String     @unique
  name      Json
  sort      Int        @default(0)
  createdAt DateTime   @default(now()) @map("created_at")
  posts     BlogPost[]

  @@map("blog_categories")
}

model BlogPost {
  id          String         @id @default(cuid())
  slug        String         @unique
  title       Json
  excerpt     Json?
  body        Json
  coverUrl    String?        @map("cover_url")
  categoryId  String?        @map("category_id")
  authorId    String?        @map("author_id")
  status      CONTENT_STATUS @default(DRAFT)
  views       Int            @default(0)
  publishedAt DateTime?      @map("published_at")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  category    BlogCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  author      User?          @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([status, publishedAt])
  @@map("blog_posts")
}

model FaqItem {
  id        String   @id @default(cuid())
  category  String   @default("general")
  question  Json
  answer    Json
  sort      Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([category])
  @@map("faq_items")
}

model Lead {
  id        String      @id @default(cuid())
  name      String
  phone     String
  message   String?
  adminNote String?     @map("admin_note")
  source    String      @default("contact")
  payload   Json?
  status    LEAD_STATUS @default(NEW)
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  @@index([status])
  @@map("leads")
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?  @map("actor_id")
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  diff      Json?
  createdAt DateTime @default(now()) @map("created_at")
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([createdAt])
  @@index([actorId])
  @@map("audit_logs")
}

enum USER_ROLE {
  ADMIN
  ARCHITECT
  USER
}

enum ROOF_FAMILY {
  flat
  shed
  gable
  hip
  pyramid
  mansard
}

enum CONTENT_STATUS {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PRICE_CATEGORY {
  FOUNDATION
  WALLS
  ROOF
  WINDOWS_DOORS
  FINISHING
  UTILITIES
  OTHER
}

enum SUBSCRIPTION_STATUS {
  PENDING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum PAYMENT_PROVIDER {
  PAYME
  CLICK
  STRIPE
}

enum PAYMENT_STATUS {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELED
}

enum LEAD_STATUS {
  NEW
  CONTACTED
  CLOSED
}

enum EXPORT_KIND {
  PDF
  RENDER
  DWG
}

enum MEDIA_TYPE {
  IMAGE
  MODEL
  DOCUMENT
}
