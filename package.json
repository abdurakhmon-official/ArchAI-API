{
  "name": "edutest-api",
  "version": "1.0.0",
  "description": "EduTest REST API - online test platform for teachers",
  "license": "ISC",
  "type": "commonjs",
  "main": "index.ts",
  "scripts": {
    "postinstall": "npx prisma generate",
    "build": "npx rimraf dist && yarn barrels && tsc --project tsconfig.compile.json && npx tsc-alias --project tsconfig.compile.json && yarn copy:prisma",
    "barrels": "barrelsby --config .barrelsby.json",
    "copy:prisma": "node -e \"require('fs').cpSync('generated/prisma','dist/generated/prisma',{recursive:true})\"",
    "dev": "yarn barrels && cross-env STAGE=local nodemon --exec ts-node index.ts",
    "start:prod": "cross-env NODE_ENV=production STAGE=production node dist/index.js",
    "test": "jest --passWithNoTests",
    "render:build": "npx prisma generate && yarn barrels && tsc -p tsconfig.compile.json && npx tsc-alias -p tsconfig.compile.json && yarn copy:prisma && npx prisma migrate deploy",
    "render:start": "node -r tsconfig-paths/register dist/index.js",
    "typecheck": "npx tsc --noEmit -p tsconfig.json",
    "generate:types": "yarn barrels && npx ts-node --project tsconfig.compile.json -r tsconfig-paths/register generate-types.ts",
    "generate:prisma": "npx prisma generate",
    "db:migrate": "npx prisma migrate dev",
    "db:deploy": "npx prisma migrate deploy",
    "db:seed": "npx prisma db seed",
    "db:reset": "npx prisma migrate reset",
    "db:studio": "npx prisma studio"
  },
  "prisma": {
    "schema": "./prisma/schema.prisma",
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.10.1",
    "@tsed/ajv": "^8.12.4",
    "@tsed/common": "^8.12.4",
    "@tsed/core": "^8.12.4",
    "@tsed/di": "^8.12.4",
    "@tsed/engines": "^8.12.4",
    "@tsed/exceptions": "^8.12.4",
    "@tsed/json-mapper": "^8.12.4",
    "@tsed/logger": "^7.0.2",
    "@tsed/logger-file": "^7.0.2",
    "@tsed/openspec": "^8.12.4",
    "@tsed/platform-cache": "^8.12.4",
    "@tsed/platform-exceptions": "^8.12.4",
    "@tsed/platform-express": "^8.12.4",
    "@tsed/platform-log-middleware": "^8.12.4",
    "@tsed/platform-middlewares": "^8.12.4",
    "@tsed/platform-params": "^8.12.4",
    "@tsed/platform-response-filter": "^8.12.4",
    "@tsed/platform-views": "^8.12.4",
    "@tsed/schema": "^8.12.4",
    "@tsed/swagger": "8.12.4",
    "ajv": "^8.17.1",
    "barrelsby": "^2.8.1",
    "bcrypt": "^6.0.0",
    "body-parser": "^2.2.0",
    "colorette": "^2.0.20",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "dotenv": "^16.3.1",
    "express": "^5.1.0",
    "express-bearer-token": "^3.0.0",
    "helmet": "^8.0.0",
    "hpp": "^0.2.3",
    "jest": "^30.0.3",
    "jsonwebtoken": "^9.0.2",
    "lodash.merge": "^4.6.2",
    "nanoid": "^5.0.7",
    "swagger-ui-dist": "^5.32.12",
    "ts-jest": "^29.2.5",
    "uuid": "^11.1.0",
    "zod": "^3.23.8",
    "zod-prisma-types": "^3.2.4",
    "zod-to-json-schema": "^3.25.2",
    "zod-to-ts": "^1.2.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/body-parser": "^1.19.5",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/hpp": "^0.2.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/lodash.merge": "^4.6.9",
    "@types/node": "^24.0.4",
    "@types/uuid": "^10.0.0",
    "nodemon": "^3.1.7",
    "prisma": "6.10.1",
    "rimraf": "^6.0.1",
    "ts-morph": "^26.0.0",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.8",
    "tsconfig-paths": "^4.2.0",
    "tslib": "^2.7.0",
    "typescript": "^5.6.2"
  }
}
