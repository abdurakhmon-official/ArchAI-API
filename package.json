{
  "name": "archai-api",
  "version": "1.0.0",
  "description": "ArchAI REST API - parametric house design platform",
  "license": "ISC",
  "type": "commonjs",
  "main": "index.ts",
  "scripts": {
    "postinstall": "npx prisma generate",
    "build": "npx rimraf dist && yarn barrels && yarn generate:types && tsc --project tsconfig.compile.json && npx tsc-alias --project tsconfig.compile.json && yarn copy:prisma",
    "barrels": "barrelsby --config .barrelsby.json",
    "copy:prisma": "node -e \"require('fs').cpSync('generated/prisma','dist/generated/prisma',{recursive:true})\"",
    "dev": "yarn barrels && cross-env STAGE=local nodemon --exec ts-node index.ts",
    "start:prod": "cross-env NODE_ENV=production STAGE=production node dist/index.js",
    "test": "jest --passWithNoTests",
    "render:build": "npx prisma generate && yarn barrels && yarn generate:types && tsc -p tsconfig.compile.json && npx tsc-alias -p tsconfig.compile.json && yarn copy:prisma && npx prisma migrate deploy && npx prisma db seed",
    "render:start": "node -r tsconfig-paths/register dist/index.js",
    "typecheck": "npx tsc --noEmit -p tsconfig.json",
    "generate:types": "yarn barrels && npx ts-node --project tsconfig.compile.json -r tsconfig-paths/register generate-types.ts",
    "generate:prisma": "npx prisma generate",
    "db:migrate": "npx prisma migrate dev",
    "db:deploy": "npx prisma migrate deploy",
    "db:seed": "npx prisma db seed",
    "db:reset": "npx prisma migrate reset",
    "db:studio": "npx prisma studio",
    "worker": "cross-env STAGE=local ts-node -r tsconfig-paths/register worker/index.ts",
    "worker:prod": "node -r tsconfig-paths/register dist/worker/index.js",
    "sync:geometry": "node scripts/sync-geometry.js",
    "depcruise": "npx depcruise --config .dependency-cruiser.js --output-type err index.ts server.ts controllers services inputs outputs middlewares modules geometry utils",
    "db:clean-test": "ts-node -r tsconfig-paths/register scripts/clean-test-data.ts"
  },
  "prisma": {
    "schema": "./prisma/schema.prisma",
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1111.0",
    "@aws-sdk/s3-request-presigner": "^3.1111.0",
    "@prisma/client": "6.10.1",
    "@tsed/ajv": "^8.12.4",
    "@tsed/common": "^8.12.4",
    "@tsed/core": "^8.12.4",
    "@tsed/di": "^8.12.4",
    "@tsed/engines": "^8.12.4",
    "@tsed/exceptions": "^8.12.4",
    "@tsed/json-mapper": "^8.12.4",
    "@tsed/logger": "^7.0.2",
    "@tsed/logger-file": "^7.0.2",
    "@tsed/openspec": "^8.12.4",
    "@tsed/platform-cache": "^8.12.4",
    "@tsed/platform-exceptions": "^8.12.4",
    "@tsed/platform-express": "^8.12.4",
    "@tsed/platform-log-middleware": "^8.12.4",
    "@tsed/platform-middlewares": "^8.12.4",
    "@tsed/platform-multer": "^8.37.1",
    "@tsed/platform-params": "^8.12.4",
    "@tsed/platform-response-filter": "^8.12.4",
    "@tsed/platform-views": "^8.12.4",
    "@tsed/schema": "^8.12.4",
    "@tsed/swagger": "8.12.4",
    "@zxcvbn-ts/core": "^4.2.0",
    "@zxcvbn-ts/language-common": "^4.1.3",
    "@zxcvbn-ts/language-en": "^4.1.1",
    "ajv": "^8.17.1",
    "argon2": "^0.45.1",
    "barrelsby": "^2.8.1",
    "bcrypt": "^6.0.0",
    "body-parser": "^2.2.0",
    "bullmq": "^6.1.1",
    "colorette": "^2.0.20",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "crypto-js": "^4.2.0",
    "date-fns": "^4.4.0",
    "dotenv": "^16.3.1",
    "express": "^5.1.0",
    "express-bearer-token": "^3.0.0",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.0.0",
    "hpp": "^0.2.3",
    "ioredis": "^6.0.0",
    "jest": "^30.0.3",
    "jsonwebtoken": "^9.0.2",
    "lodash.merge": "^4.6.2",
    "multer": "^2.2.0",
    "nanoid": "^5.0.7",
    "nodemailer": "^9.0.5",
    "puppeteer": "^25.7.0",
    "stripe": "^22.5.0",
    "swagger-ui-dist": "^5.32.12",
    "three": "^0.185.1",
    "ts-jest": "^29.2.5",
    "uuid": "^11.1.0",
    "zod": "^3.23.8",
    "zod-prisma-types": "^3.2.4",
    "zod-to-json-schema": "^3.25.2",
    "zod-to-ts": "^1.2.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/body-parser": "^1.19.5",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.6",
    "@types/cors": "^2.8.17",
    "@types/crypto-js": "^4.2.2",
    "@types/express": "^5.0.0",
    "@types/hpp": "^0.2.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/lodash.merge": "^4.6.9",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.0.4",
    "@types/nodemailer": "^8.0.1",
    "@types/three": "^0.185.4",
    "@types/uuid": "^10.0.0",
    "dependency-cruiser": "^18.2.0",
    "nodemon": "^3.1.7",
    "prisma": "6.10.1",
    "rimraf": "^6.0.1",
    "ts-morph": "^26.0.0",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.8",
    "tsconfig-paths": "^4.2.0",
    "tslib": "^2.7.0",
    "typescript": "^5.6.2"
  }
}
